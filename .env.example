# Free key from https://openrouter.ai/keys - without it the app runs with the offline mock assistant.
OPENROUTER_API_KEY=
# mock | openrouter (default: openrouter when a key is set, otherwise mock)
LLM_PROVIDER=
LLM_MODEL=google/gemma-4-31b-it:free
# Any OpenAI-compatible endpoint works, e.g. local Ollama: http://host.docker.internal:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT=90
# DATABASE_URL=postgresql+psycopg://formfill:formfill@db:5432/formfill
